# Copy to backend/.env for local development. Replace placeholders locally.
# Never commit backend/.env or use these values in a deployed environment.
APP_ENV=development
APP_SECRET_KEY=
DATABASE_URL=postgresql+psycopg://mediroute:replace_me@localhost:5432/mediroute
TEST_DATABASE_URL=postgresql+psycopg://mediroute_test:replace_me@localhost:5432/mediroute_test
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
